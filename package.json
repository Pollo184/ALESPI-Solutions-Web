{
  "name": "alespi-soluions-web",
  "version": "1.0.0",
  "description": "Landing page corporativa de ALESPI Solutions para presentar servicios HVAC, experiencia y contacto.",
  "private": true,
  "main": "script.js",
  "scripts": {
    "build:css": "tailwindcss -i ./input.css -o ./output.css --minify",
    "watch:css": "tailwindcss -i ./input.css -o ./output.css --watch",
    "build": "npm run build:css",
    "dev": "npm run watch:css",
    "dev:css": "npm run watch:css",
    "serve": "node server.js",
    "serve:static": "live-server --port=8080",
    "serve:app": "node server.js",
    "start": "npm run serve",
    "preview": "npm run build && npm run serve",
    "test": "echo \"No automated tests configured\""
  },
  "keywords": [
    "alespi",
    "hvac",
    "landing-page",
    "tailwindcss",
    "frontend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@sendgrid/mail": "^8.1.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "nodemailer": "^8.0.9"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "live-server": "^1.2.2",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19"
  }
}
